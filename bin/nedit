#!/usr/bin/env bash

blue() {
  echo -e "\033[34m$1\033[0m"
}

cyan() {
  echo -e "\033[36m$1\033[0m"
}

nedit_help() {
  echo
  blue "nedit"
  blue "Usage: nedit [file|command]"
  echo
  blue "Commands:"
  cyan " help|--help|-h - Show this help menu"
  cyan " packages - Edit your nup package list"
  echo  
}

case "$1" in
  help|--help|-h)
    nedit_help
    exit 0
    ;;
    
  packages)
    helix ~/nutils-data/nup/packages.sh
    exit 0
    ;;
esac

helix "$(command -v "$1" || echo "$1")"

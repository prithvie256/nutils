#!/usr/bin/env bash

data="$HOME/nutils-data"
[[ -f "$HOME/.config/nutils/env.conf" ]] && source "$HOME/.config/nutils/env.conf"

nfile_data="$data/nfile"

green() {
  echo -e "\033[32m$1\033[0m"
}

blue() {
  echo -e "\033[34m$1\033[0m"
}

cyan() {
  echo -e "\033[36m$1\033[0m"
}

nfile_help() {
  echo
  blue "nfile"
  blue "Usage: nfile [command]"
  echo
  blue "Commands:"
  cyan " help|--help|-h - Show this help menu"
  echo
}

case "$1" in
  help|--help|-h)
    nfile_help
    exit 0
    ;;
esac

mkdir -p "$nfile_data"

"$@" > "$nfile_data"/out.txt

green "Created file in ~/nutils-data/nfile/out.txt."
echo

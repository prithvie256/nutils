#!/usr/bin/env bash

current_dir=$(pwd)

red() {
  echo -e "\033[31m$1\033[0m"
}

green() {
  echo -e "\033[32m$1\033[0m"
}

yellow() {
  echo -e "\033[33m$1\033[0m"
}

blue() {
  echo -e "\033[34m$1\033[0m"
}

cyan() {
  echo -e "\033[36m$1\033[0m"
}

check_for_git() {
  if [[ ! -d "$current_dir/.git" ]]; then
    red "Git repo not found. Run ngit init."
    echo
    exit 1
  fi
}

ngit_setup() {
  if [[ ! -f ~/.ssh/id_ed25519.pub ]]; then
    blue "Welcome to the ngit setup process! You'll be asked exactly 2 questions."
    sleep 1
    echo

    yellow "What is your username? \n"
    read username
    git config --global --replace-all user.name "$username"
    echo

    yellow "What is your email? For example, 'somerandomdude@something.com' \n"
    read email
    git config --global --replace-all user.email "$email"
    echo

    printf "\n" | ssh-keygen -t ed25519 -C "$email" &>/dev/null

    ssh_key_pub="$(cat ~/.ssh/id_ed25519.pub)"
    green "Setup complete! One more thing, and this HAS to be manual because the tool can't do it for you, go to your account's settings (GitHub or GitLab) and input: \n$ssh_key_pub"
    echo
    echo "Don't worry, this is your public SSH key. Also, if you want to see the key later on, just do cat ~/.ssh/id_ed25519.pub."
    sleep 10
  else
    echo "ngit is already set up!"
    sleep 1
    clear
  fi
}

remote() {
  git remote add "$1" "git@${1}.com:${2}.git" &>/dev/null || git remote set-url "$1" "git@${1}.com:${2}.git"
}

ngit_init() {
  blue "Folder to initialize: $current_dir"
  echo

  yellow "Which website are you using? \n1. GitHub \n2. GitLab \n3. Both \n\nType the number of your choice. \n"
  read website_choice

  echo
  yellow "Enter your repo URL in this format: 'username/repo_name' \n"
  read repo

  git init -b main &>/dev/null
  
  case "$website_choice" in
    1) remote "github" "$repo" ;;
    2) remote "gitlab" "$repo" ;;

    3)
      remote "github" "$repo"
      remote "gitlab" "$repo"
      ;;
    
    *) red "Uhh $website_choice isn't a valid choice... try again!"; exit 1
  esac
}

ngit_help() {
  echo
  blue "ngit"
  blue "Usage: ngit [command]"
  echo
  blue "Commands:"
  cyan " help|--help|-h - Show this help menu"
  cyan " setup - Sets up local Git information such as username and email, generates an SSH key for you and guides you through setting that key up in your GitHub/GitLab account"
  cyan " init - Initializes a Git repository in whichever folder you're in, lets you choose a website to connect the local repo to (GitHub, GitLab or both) and sets up remotes for you"
  cyan " add - Stages all files in your repo"
  cyan " commit - Lets you write a commit message"
  cyan " push - Lets you push your repo automatically to whichever website(s) you chose"
  echo
}

case "$1" in
  help|--help|-h)
    ngit_help
    exit 0
    ;;
esac

[[ -t 1 ]] && clear

case "$1" in
  setup)
    ngit_setup
    exit 0
    ;;

  init)
    ngit_init
    exit 0
    ;;

  add)
    check_for_git
    git add .
    green "Files staged!"
    echo
    ;;

  commit)
    check_for_git
    yellow "Type in your commit message: \n"
    read message
    git commit -m "$message" >/dev/null
    echo "Message committed!"
    echo
    ;;

  push)
    check_for_git
    remotes=($(git remote 2>/dev/null))

    if [[ "${#remotes[@]}" == 0 ]]; then
      red "No remotes found. Run ngit init in your repo first!"
      exit 1
    fi

    for r in "${remotes[@]}"; do
      git push -u --quiet "$r" >/dev/null
    done
  
    green "Changes pushed!"
    echo
esac

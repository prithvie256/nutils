#!/usr/bin/env bash

shopt -s globstar

nutils="$HOME/nutils"

data="$HOME/nutils-data"
[[ -f "$HOME/.config/nutils/env.conf" ]] && source "$HOME/.config/nutils/env.conf"

nup_data="$data/nup"
selfdir="$(cd -- "$(dirname -- "${BASH_SOURCE}")" && pwd)"

green() {
  echo -e "\033[32m$1\033[0m"
}

yellow() {
  echo -e "\033[33m$1\033[0m"
}

blue() {
  echo -e "\033[34m$1\033[0m"
}

cyan() {
  echo -e "\033[36m$1\033[0m"
}

nup_start() {
if ! sudo -n true &>/dev/null; then
  sudo -p $'\033[33mEnter your [sudo] password: \033[0m' -v
  echo
fi

while true; do
  sudo -n true
  sleep 60
  kill -0 "$$" || exit
done 2>/dev/null &
}

nup_packages() {
  source "$nup_data/packages.sh"

  if [[ "$quick" != 1 ]]; then
    whitelist=(
      "${essentials[@]}" "${packages[@]}" "${games[@]}"
      "${nutils_deps[@]}" "${ngame_deps[@]}" "${nmusic_deps[@]}"
    )

    blue "Installing packages..."
    to_install=$(pacman -T "${whitelist[@]}")
    [[ -n "$to_install" ]] && paru -S --noconfirm --needed $to_install #&>/dev/null

    to_purge=$(comm -23 <(pacman -Qqe | sort) <(printf "%s\n" "${whitelist[@]}" | sort))

    if [[ -n "$to_purge" ]]; then
      echo
      blue "Purging unwhitelisted packages..."
      sudo pacman -Rns --noconfirm $to_purge &>/dev/null
    fi

    echo
    blue "Updating system..."
    echo
    paru -Syu --noconfirm #&>/dev/null

    echo
    blue "Removing orphaned packages..."
    sudo pacman -Rns --noconfirm $(pacman -Qdtq) &>/dev/null
    echo
  fi
}

nup_packages_dry() {
  source "$nup_data/packages.sh"

  whitelist=(
    "${essentials[@]}" "${packages[@]}" "${games[@]}"
    "${nutils_deps[@]}" "${ngame_deps[@]}" "${nmusic_deps[@]}"
  )

  blue "Packages that would be installed:"
  echo
  to_install=$(pacman -T "${whitelist[@]}")

  if [[ -z "$to_install" ]]; then
    cyan "None"
  else
    cyan "$to_install"
  fi

  echo
  blue "Packages that would be purged:"
  to_purge=$(comm -23 <(pacman -Qqe | sort) <(printf "%s\n" "${whitelist[@]}" | sort))
  echo
  
  if [[ -z "$to_purge" ]]; then
    cyan "None"
  else
    cyan "$to_purge"
  fi

  echo
  blue "Packages that would be updated:"
  to_update=$(paru -Qu)
  echo
  
  if [[ -z "$to_update" ]]; then
    cyan "None"
  else
    cyan "$to_update"
  fi

  echo
  blue "Orphaned packages that would be removed:"
  orphan=$(pacman -Qdtq)
  echo
  
  if [[ -z "$orphan" ]]; then
    cyan "None"
  else
    cyan "$orphan"
  fi

  echo
}

nup_paths() {
  blue "Creating configurations..."

  for i in "$nup_data/paths"/**/*.conf; do
    [[ ! -f "$i" ]] && continue
    filedir="$(cd -- "$(dirname -- "$i")" && pwd)"
  
    echo
    blue "Sourcing $i..."
    [[ -f "$i" ]] && source "$i"

    echo
    cyan "Target file: $target_file"
    cyan "Destination: $destination"
  
    mkdir -p "$(dirname "$destination")"
    sudo cp -f "$target_file" "$destination"
    echo
  done
}

nup_modules() {
  blue "Executing modules..."

  for i in "$nup_data/modules"/**/*.sh; do
    [[ ! -f "$i" ]] && continue
    
    if [[ "$auto_modules" != 1 ]]; then
      echo
      blue "Module: $(basename "$i")"
      yellow "Execute? [y/n]"
      echo
      read choice
    else
      choice="y"
    fi

    echo

    [[ "$choice" == "y" ]] && source "$i"
  done
}

nup_essential() {
  echo
  blue "Setting up permissions..."
  sudo chown $USER:$USER "$0"
  sudo chmod +x "$selfdir"/*
  sudo chown -R $USER:$USER ~

  echo
  blue "Setting up Ly..."
  sudo systemctl disable getty@tty2.service &>/dev/null
  sudo systemctl enable --now ly@tty2.service &>/dev/null

  echo
  blue "Setting up Bluetooth..."
  sudo systemctl enable --now bluetooth &>/dev/null

  echo
  blue "Clearing cache..."
  rm -rf ~/.cache
  paru -Scc --noconfirm &>/dev/null
}

nup_done() {
  echo
  green "Done!"
  echo
}

nup_help() {
  echo
  blue "nup"
  blue "Usage: nup [command]"
  echo
  blue "Commands:"
  cyan " help|--help|-h - Show this help menu"
  cyan " quick|-q - Doesn't execute anything to do with packages"
  cyan " automodules|-am - Bypass confirmation prompt when executing modules"
  cyan " dry|-d - Dry run anything to do with packages"
  blue " No flags = a normal nup run"
  echo
}

nup_setup() {
  if [[ ! -d "$nup_data" ]]; then
    yellow "Configuration folder not found. Pick a sane default (type the corresponding number): \n1. Niri \nMore will be added soon."
    echo
    read default_choice

    case "$default_choice" in
      1)
        default_choice="Niri"
        default="$nutils/templates/niri"
        ;;
    esac

    cp -rf "$default" "$nup_data"

    echo
    green "Configuration folder created!"
    echo
  fi
}

mkdir -p "$data"

for i in "$@"; do
  case "$i" in
    quick|-q)
      quick=1
      ;;

    automodules|-am)
      auto_modules=1
      ;;

    dry|-d)
      dry_run=1
  esac
done

case "$1" in
  help|--help|-h)
    nup_help
    exit 0
    ;;
esac

clear

nup_setup
nup_start

if [ "$dry_run" == 1 ]; then
  nup_packages_dry
else
  nup_packages
fi

nup_paths
nup_modules
nup_essential
nup_done

#!/usr/bin/env bash

blue() {
  echo -e "\033[34m$1\033[0m"
}

cyan() {
  echo -e "\033[36m$1\033[0m"
}

ndl_help() {
  echo
  blue "ndl"
  blue "Usage: ndl [url|command]"
  echo
  blue "Commands:"
  cyan " help|--help|-h - Show this help menu"
  echo  
}

case "$1" in
  help|--help|-h)
    ndl_help
    exit 0
    ;;
esac

aria2c -s16 -x16 "$@"

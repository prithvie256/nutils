#!/usr/bin/env bash

data="$HOME/nutils-data"
[[ -f "$HOME/.config/nutils/env.conf" ]] && source "$HOME/.config/nutils/env.conf"

nmusic_data="$data/nmusic"

other="$nmusic_data/Other"

mkdir -p "$other"

folder_list="$(fd . "$nmusic_data" -t d -x printf "%s\t%s\n" "{/.}" "{}")"

green() {
  echo -e "\033[32m$1\033[0m"
}

yellow() {
  echo -e "\033[33m$1\033[0m"
}

blue() {
  echo -e "\033[34m$1\033[0m"
}

cyan() {
  echo -e "\033[36m$1\033[0m"
}

pink() {
  echo -e "\033[38;5;13m$1\033[0m"
}

nmusic_download() {
  blue "Downloading... (this will take some time if it's a playlist ((especially a big one)), so go do something to kill time!)"
  echo

  playlist="$(yt-dlp --flat-playlist --print "%(title)s|%(webpage_url)s" "$2" 2>/dev/null)"
  mapfile -t files < <(fd . "$other" -e mp3)
  
  echo "$playlist" | while IFS='|' read -r song url; do
    found=0
    
    for file in "${files[@]}"; do
      filename="$(basename "$file")"

      alt_slash="$(printf '\u29f8')"
      safe_song="${song//\//$alt_slash}"
      
      if [[ "$filename" == "$safe_song.mp3" ]]; then
        pink "$song already exists!"
        echo
        found=1
        break
      fi
    done
  
    if [[ "$found" == 0 ]]; then
      blue "Downloading $song..."
      echo
      yt-dlp --extractor-args "youtube:player_client=web_embedded" -o "$other/%(title)s.%(ext)s" -x --audio-format mp3 --no-windows-filenames "$url" &>/dev/null
    fi
  done

  green "Done!"
  echo
}

nerdling_music() {
  if [[ -d "$1" ]]; then
    yellow "Shuffle? [y/n] "
    read ans
    
    echo
    
    if [[ "$ans" == "y" || -z "$ans" ]]; then
      nmusic_mpv shuffle "$1"
      return
    else
      nmusic_mpv "$1"
      return
    fi
  fi

  if [[ -f "$1" ]]; then
    nmusic_mpv "$1" --input-conf=<(echo "> quit")
    [[ $? != "4" ]] && nmusic_mpv shuffle "$(dirname "$1")"
  fi
}

music_entry_fzf() {
  fd . "$1" -e mp3 -x printf "%s\t%s\n" "{/.}" "{}" | sort
}

nmusic_fzf() {
  cmd=(
    --border
    --pointer='>'
    --prompt='>> '
    --color='hl:#505050,hl+:#4cbdfc,fg:#505050,fg+:#4cbdfc,bg+:#141419,pointer:#4cbdfc,info:#505050,spinner:#505050,query:#505050,prompt:#505050'
  )
  
  [[ "$1" == "two" ]] && cmd+=( --delimiter=$'\t' --with-nth=1 --accept-nth=2)
  fzf "${cmd[@]}" 2>/dev/null
}

nmusic_mpv() {
  shuffle=""
  [[ "$1" == "shuffle" ]] && { shuffle="--shuffle"; shift; }
  mpv --msg-level=cplayer=warn --term-status-msg='Playing: ${filename/no-ext} [${percent-pos}%]' --term-playing-msg=' ' $shuffle "$@"
}

picker() {
  printf '\e]12;#4cbdfc\e\\' >&2

  while true; do
    clear
    folder="$( { echo -e "All\t$nmusic_data"; echo "$folder_list"; } | nmusic_fzf two)"
  
    [[ -z "$folder" ]] && break

    song_list="$(printf "%s\t%s\n" "Play All" "$folder"; music_entry_fzf "$folder")"
    selected="$(echo "$song_list" | nmusic_fzf two)"

    [[ -z "$selected" ]] && continue

    nerdling_music "$selected"
  done

  printf '\e]112\e\\' >&2
}

nmusic_help() {
  echo
  blue "nmusic"
  blue "Usage: nmusic [command]"
  echo
  blue "Commands:"
  cyan " help|--help|-h - Show this help menu"
  cyan " download [YouTube Song/Playlist URL] - Use yt-dlp to download a song/playlist"
  cyan " list - List all songs in nmusic's root folder"
  blue " No flags = nmusic's interactive music picker"
  echo
}

if [[ -z "$1" ]]; then
  picker
  exit 0
fi

case "$1" in
  help|--help|-h)
    nmusic_help
    exit 0
    ;;
    
  download)
    nmusic_download "$@"
    ;;
  list)
    fd . "$nmusic_data" -e mp3 -x printf "%s\n" "{/.}"
    ;;
  *)
    nerdling_music "$@"
esac

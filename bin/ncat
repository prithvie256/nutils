#!/usr/bin/env bash

selfdir="$(cd -- "$(dirname -- "${BASH_SOURCE}")" && pwd)"

blue() {
  echo -e "\033[34m$1\033[0m"
}

cyan() {
  echo -e "\033[36m$1\033[0m"
}

ncat_help() {
  echo
  blue "ncat"
  blue "Usage: ncat [file|command]"
  echo
  blue "Commands:"
  cyan " help|--help|-h - Show this help menu"
  cyan " nutils - Neatly cat every nutils tool"
  cyan " packages - Show your nup package list"
  echo  
}

case "$1" in
  help|--help|-h)
    ncat_help
    exit 0
    ;;

  nutils)
    echo "nutils"
    echo
    
    {
      for i in "$selfdir"/*; do
        util_name="$(basename "$i")"
        blue "$util_name"
        echo
        util_content="$(cat "$i")"
        cyan "${util_content//\\/\\\\}"
        echo
      done
    }

    exit 0
    ;;

  packages)
    cat ~/nutils/config/nup_packages.sh
    exit 0
    ;;
esac

cat "$(command -v "$@")" 2>/dev/null || cat "$@"
